# LLM Provider (required for default setup)
LITELLM_API_KEY=your-litellm-api-key-here
LITELLM_API_BASE=http://your-litellm-proxy:4000/

# GitHub (required for fetching diffs and posting comments)
GITHUB_TOKEN=ghp_your_github_token_here

# Alternative providers (optional)
OPENROUTER_API_KEY=
AZURE_API_KEY=

# Concurrent llm call limit
MAX_CONCURRENT_LLM_CALLS=5

# Logging
LOG_LEVEL=INFO
